# SahayaK — environment variables (all optional)
# Copy to .env.local for local overrides, or set these in your Vercel project
# (Settings → Environment Variables). Without them, the built-in demo
# credentials from src/lib/supabase.ts are used.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key — sb_publishable_… or the legacy anon JWT.
# Publishable keys are public by design; never put a service_role key here.
VITE_SUPABASE_ANON_KEY=
